#include <windows.h>
#include "resource.h"

IDI_APP ICON "icon.ico"

// MSVC: CMake passes app.manifest to the linker, which embeds it.
// MinGW (windres): embed the manifest as a resource instead.
#ifdef __GNUC__
1 RT_MANIFEST "app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SOFTTEMPEST_VERSION_MAJOR,SOFTTEMPEST_VERSION_MINOR,SOFTTEMPEST_VERSION_PATCH,0
 PRODUCTVERSION SOFTTEMPEST_VERSION_MAJOR,SOFTTEMPEST_VERSION_MINOR,SOFTTEMPEST_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Soft TEMPEST display-masking overlay"
            VALUE "FileVersion",      SOFTTEMPEST_VERSION_STR
            VALUE "InternalName",     "SoftTempest"
            VALUE "OriginalFilename", "SoftTempest.exe"
            VALUE "ProductName",      "Soft TEMPEST overlay"
            VALUE "ProductVersion",   SOFTTEMPEST_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
